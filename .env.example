# AI Emergency Command Center - Environment Configuration
# Copy this file to .env.local to configure real API providers.
# If no keys are provided, the system runs with the high-fidelity offline Llama 3.1 Neural Core fallback.

# Groq API for sub-second Meta Llama 3.1 70B Neural Triage
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Google Gemini API for Scene Image Vision Analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API for ICS-201 Incident Command Sheet Strategy
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude API (Alternative for complex multi-agency reasoning)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# System Port & Host
PORT=3000
NODE_ENV=development
